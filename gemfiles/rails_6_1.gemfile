# frozen_string_literal: true

source 'https://rubygems.org'

gem 'activerecord', '~> 6.1.0'
gem 'activesupport', '~> 6.1.0'
gem 'railties', '~> 6.1.0'

if RUBY_VERSION >= '3.4'
  gem 'base64'
  gem 'benchmark'
  gem 'bigdecimal'
  gem 'drb'
  gem 'logger'
  gem 'mutex_m'
  gem 'ostruct'
end

eval_gemfile 'common.rb'
